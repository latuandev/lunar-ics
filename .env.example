# Local app host binding
APP_HOST=0.0.0.0

# Local app port. Keep 8000 when using the provided Docker/Nginx setup.
APP_PORT=8000

# Dataset directory. Relative path works for local CLI and inside the container image.
DATA_DIR=./data

# Docker Compose host port published by the nginx container.
NGINX_HOST_PORT=18080

# Vietnam timezone used by the service.
TZ=Asia/Ho_Chi_Minh

# Logging level for the Python app.
LOG_LEVEL=INFO

# Cache max-age used by static responses.
STATIC_CACHE_SECONDS=86400
